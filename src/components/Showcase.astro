---
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { phoneScreen, type PhoneScreen } from '../i18n/screens';
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { home, shots } = getContent(lang);
const alt = (id: string) => shots.find((s) => s.id === id)?.alt ?? '';

// Two screens per row. The second report page repeats what the first one's
// description already says, so it is decorative for screen readers.
const screens: Record<string, { name: PhoneScreen; alt: string }[]> = {
  day: [
    { name: 'day', alt: alt('day') },
    { name: 'timeline', alt: alt('timeline') },
  ],
  insights: [
    { name: 'chart', alt: alt('chart') },
    { name: 'statistics', alt: alt('statistics') },
  ],
  reports: [
    { name: 'report', alt: alt('report') },
    { name: 'report-2', alt: '' },
  ],
};

const rows = home.showcase.map((row) => ({ ...row, images: screens[row.id] ?? [] }));
---

<section class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl space-y-24 px-5 sm:space-y-32 sm:px-8">
    {
      rows.map((row, i) => (
        <div
          class:list={[
            'reveal grid items-center gap-12 lg:grid-cols-2 lg:gap-16',
            i % 2 === 1 && 'lg:[&>*:first-child]:order-2',
          ]}
        >
          <div class="max-w-lg">
            <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-brand-600 dark:text-brand-300">
              {row.eyebrow}
            </p>
            <h2 class="text-display mt-4 text-3xl font-bold sm:text-[2.5rem]">{row.title}</h2>
            <p class="mt-5 text-[17px] leading-relaxed text-muted">{row.body}</p>

            <ul class="mt-7 space-y-3.5">
              {row.points.map((point) => (
                <li class="flex items-start gap-3 text-[15px] text-ink">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-700/30 dark:text-brand-200">
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 12 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M2.5 6.2l2.4 2.4L9.5 3.9" />
                    </svg>
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <div class="relative mx-auto flex w-full max-w-md justify-center gap-4 sm:gap-6">
            <div
              aria-hidden="true"
              class="absolute inset-x-6 top-8 -z-10 h-3/4 rounded-full bg-brand-300/25 blur-[70px] dark:bg-brand-600/25"
            />
            {row.images.map((img, idx) => (
              <DeviceFrame
                image={phoneScreen(lang, img.name)}
                alt={img.alt}
                class={['w-1/2 max-w-[220px]', idx === 1 ? 'mt-10' : ''].join(' ')}
                sizes="(min-width: 1024px) 220px, 42vw"
                widths={[220, 320, 440]}
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
