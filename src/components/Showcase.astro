---
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { phoneScreen, type PhoneScreen } from '../i18n/screens';
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { home, shots } = getContent(lang);
const alt = (id: string) => shots.find((s) => s.id === id)?.alt ?? '';

// Two screens per panel, the second a step behind the first. The second
// report page repeats what the first one's description already says, so it
// is decorative for screen readers.
const screens: Record<string, { name: PhoneScreen; alt: string }[]> = {
  day: [
    { name: 'day', alt: alt('day') },
    { name: 'timeline', alt: alt('timeline') },
  ],
  insights: [
    { name: 'chart', alt: alt('chart') },
    { name: 'statistics', alt: alt('statistics') },
  ],
  reports: [
    { name: 'report', alt: alt('report') },
    { name: 'report-2', alt: '' },
  ],
};

const rows = home.showcase.map((row) => ({ ...row, images: screens[row.id] ?? [] }));
---

<section class="showcase pb-6 sm:pb-10">
  <div class="mx-auto max-w-6xl space-y-5 px-3 sm:space-y-6 sm:px-6">
    {
      rows.map((row, i) => (
        <article class:list={['showcase-panel reveal', i % 2 === 1 && 'showcase-panel--flip']}>
          <div class="showcase-copy">
            <p class="t-eyebrow">{row.eyebrow}</p>
            <h2 class="t-title mt-3">{row.title}</h2>
            <p class="mt-5 text-[17px] leading-relaxed text-muted text-pretty">{row.body}</p>

            <ul class="mt-7 space-y-3">
              {row.points.map((point) => (
                <li class="flex items-start gap-3 text-[15.5px] leading-snug text-ink">
                  <svg
                    class="mt-[3px] h-[18px] w-[18px] shrink-0 text-accent"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M10 1.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17zm3.6 5.3a.75.75 0 0 0-1.06.05L8.9 10.9 7.4 9.4a.75.75 0 1 0-1.06 1.06l2.06 2.06a.75.75 0 0 0 1.09-.03l4.15-4.6a.75.75 0 0 0-.04-1.09z" />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <div class="showcase-media" dir="ltr">
            {row.images.map((img, idx) => (
              <DeviceFrame
                image={phoneScreen(lang, img.name)}
                alt={img.alt}
                class={idx === 0 ? 'showcase-phone showcase-phone--front' : 'showcase-phone showcase-phone--back'}
                sizes="(min-width: 1024px) 270px, 46vw"
                widths={[220, 270, 440, 540]}
              />
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Each feature gets a panel of its own, the phones rising out of its
     lower edge – the way Apple shows a feature on its iOS pages. */
  .showcase-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    border-radius: 2.25rem;
    background: var(--canvas-alt);
    isolation: isolate;
  }

  .dark .showcase-panel {
    background: var(--surface);
  }

  .showcase-copy {
    padding: 2.75rem 1.75rem 0;
  }

  .showcase-media {
    --pw: min(44vw, 230px);
    position: relative;
    height: calc(var(--pw) * 1.72);
    margin-top: 2.5rem;
  }

  /* A soft light behind the phones. */
  .showcase-media::before {
    content: '';
    position: absolute;
    inset: 10% 0 0;
    z-index: -1;
    background: radial-gradient(55% 55% at 50% 60%, var(--glow), transparent 75%);
  }

  .showcase-media :global(.showcase-phone) {
    position: absolute;
    width: var(--pw);
  }

  .showcase-media :global(.showcase-phone--front) {
    z-index: 2;
    left: calc(50% - var(--pw) * 0.86);
    top: calc(var(--pw) * 0.1);
  }

  .showcase-media :global(.showcase-phone--back) {
    z-index: 1;
    left: calc(50% - var(--pw) * 0.08);
    top: calc(var(--pw) * 0.42);
  }

  @media (min-width: 640px) {
    .showcase-copy {
      padding: 3.5rem 3.5rem 0;
      max-width: 40rem;
    }
  }

  @media (min-width: 1024px) {
    .showcase-panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      min-height: 40rem;
    }

    .showcase-copy {
      align-self: center;
      padding: 4.5rem 0 4.5rem 4.5rem;
    }

    .showcase-media {
      --pw: 270px;
      height: auto;
      margin-top: 0;
    }

    .showcase-media :global(.showcase-phone--front) {
      top: 6.5rem;
    }

    .showcase-media :global(.showcase-phone--back) {
      top: 11.5rem;
    }

    /* Every second panel puts the phones first. */
    .showcase-panel--flip .showcase-copy {
      order: 2;
      padding: 4.5rem 4.5rem 4.5rem 0;
    }
  }

  /* Physical padding above must follow the reading direction. */
  @media (min-width: 1024px) {
    :global([dir='rtl']) .showcase-copy {
      padding: 4.5rem 4.5rem 4.5rem 0;
    }

    :global([dir='rtl']) .showcase-panel--flip .showcase-copy {
      padding: 4.5rem 0 4.5rem 4.5rem;
    }
  }

  /* The phones follow the panel in with a short delay and a longer rise. */
  :global(.js) .showcase-panel :global(.showcase-phone) {
    opacity: 0;
    transform: translateY(70px);
    transition:
      opacity 1s var(--ease-out-soft),
      transform 1.4s var(--ease-out-soft);
  }

  :global(.js) .showcase-panel :global(.showcase-phone--front) {
    transition-delay: 0.15s;
  }

  :global(.js) .showcase-panel :global(.showcase-phone--back) {
    transition-delay: 0.3s;
  }

  :global(.js) .showcase-panel.is-visible :global(.showcase-phone) {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .showcase-panel :global(.showcase-phone) {
      opacity: 1;
      transform: none;
    }
  }
</style>
