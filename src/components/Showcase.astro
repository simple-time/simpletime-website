---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import DeviceFrame from './DeviceFrame.astro';
import overviewScreen from '../assets/screens/overview.png';
import timelineScreen from '../assets/screens/timeline.png';
import analyzeScreen from '../assets/screens/analyze.png';
import reportsScreen from '../assets/screens/reports.png';
import customizeScreen from '../assets/screens/customize.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = [
  {
    key: 'day',
    images: [
      { src: overviewScreen, alt: 'Daily list of tracked activities with durations' },
      { src: timelineScreen, alt: 'Hour-by-hour timeline of a tracked day' },
    ],
  },
  {
    key: 'insight',
    images: [
      { src: analyzeScreen, alt: 'Donut chart breaking down tracked time by task' },
      { src: reportsScreen, alt: 'Detailed SimpleTime report for a date range' },
    ],
  },
  {
    key: 'personal',
    images: [{ src: customizeScreen, alt: 'Task editor with colour and icon options' }],
  },
] as const;
---

<section class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl space-y-24 px-5 sm:space-y-32 sm:px-8">
    {
      rows.map((row, i) => (
        <div
          class:list={[
            'reveal grid items-center gap-12 lg:grid-cols-2 lg:gap-16',
            i % 2 === 1 && 'lg:[&>*:first-child]:order-2',
          ]}
        >
          <div class="max-w-lg">
            <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-brand-600 dark:text-brand-300">
              {t(`showcase.${row.key}.eyebrow` as any)}
            </p>
            <h2 class="text-display mt-4 text-3xl font-bold sm:text-[2.5rem]">
              {t(`showcase.${row.key}.title` as any)}
            </h2>
            <p class="mt-5 text-[17px] leading-relaxed text-muted">
              {t(`showcase.${row.key}.body` as any)}
            </p>

            <ul class="mt-7 space-y-3.5">
              {[1, 2, 3].map((n) => (
                <li class="flex items-start gap-3 text-[15px] text-ink">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-700/30 dark:text-brand-200">
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 12 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M2.5 6.2l2.4 2.4L9.5 3.9" />
                    </svg>
                  </span>
                  {t(`showcase.${row.key}.point${n}` as any)}
                </li>
              ))}
            </ul>
          </div>

          <div
            class:list={[
              'relative mx-auto flex w-full max-w-md justify-center',
              row.images.length > 1 ? 'gap-4 sm:gap-6' : '',
            ]}
          >
            <div
              aria-hidden="true"
              class="absolute inset-x-6 top-8 -z-10 h-3/4 rounded-full bg-brand-300/25 blur-[70px] dark:bg-brand-600/25"
            />
            {row.images.map((img, idx) => (
              <DeviceFrame
                image={img.src}
                alt={img.alt}
                class={[
                  row.images.length > 1 ? 'w-1/2 max-w-[220px]' : 'w-2/3 max-w-[280px]',
                  idx === 1 ? 'mt-10' : '',
                ].join(' ')}
                sizes="(min-width: 1024px) 220px, 42vw"
                widths={[220, 320, 440, 560]}
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
