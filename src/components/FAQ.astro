---
import type { Lang } from '../i18n/ui';
import { langPrefix } from '../i18n/utils';
import { getContent, faqById, HOME_FAQ } from '../i18n/content';
import FaqEntry from './FaqEntry.astro';

interface Props {
  lang: Lang;
}

// The six questions people ask before downloading. The full list is on /faq/;
// `#faq` stays here because the app links to it (Website.faq).
const { lang } = Astro.props;
const { faq } = getContent(lang).home;
const entries = faqById(lang);
const items = HOME_FAQ.map((id) => entries.get(id)).filter((item) => item !== undefined);
---

<section id="faq" class="scroll-mt-14 bg-canvas-alt py-20 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 sm:px-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2 class="reveal t-section">{faq.title}</h2>
      <p class="reveal delay-1 t-intro mt-5 text-muted">{faq.subtitle}</p>
      <a href={`${langPrefix(lang)}/faq/`} class="reveal delay-2 link-more mt-7 text-[17px]">
        {faq.button}
        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 2.5L8 6l-3.5 3.5"></path>
        </svg>
      </a>
    </div>

    <div class="reveal delay-1 faq-list divide-y divide-line-strong border-y border-line-strong">
      {items.map((item) => <FaqEntry lang={lang} item={item} />)}
    </div>
  </div>
</section>
