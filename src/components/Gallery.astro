---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getContent } from '../i18n/content';
import { phoneScreen, type PhoneScreen } from '../i18n/screens';
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { home, shots } = getContent(lang);
// The seven App Store images, in App Store order, with their headlines – set
// the way the App Store sets them: headline on the app's blue, the phone
// rising from below.
---

<section id="gallery" class="gallery scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="reveal t-section max-w-3xl">{home.gallery.title}</h2>
    <p class="reveal delay-1 t-intro mt-5 max-w-2xl text-muted">{home.gallery.subtitle}</p>
  </div>

  <!-- Scroll rail: swipeable on touch, keyboard scrollable everywhere. -->
  <div
    class="reveal-media delay-2 gallery-rail snap-rail mt-12 sm:mt-14"
    tabindex="0"
    role="group"
    aria-label={home.gallery.title}
    data-gallery
  >
    <ul class="gallery-track">
      {
        shots.map((s) => (
          <li class="gallery-tile brand-surface">
            <div class="gallery-tile__copy">
              <h3 class="gallery-tile__title">{s.title}</h3>
              <p class="gallery-tile__caption">{s.caption}</p>
            </div>
            <DeviceFrame
              image={phoneScreen(lang, s.id as PhoneScreen)}
              alt={s.alt}
              class="gallery-tile__phone"
              sizes="(min-width: 640px) 290px, 62vw"
              widths={[240, 290, 480, 580]}
            />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mx-auto mt-7 flex max-w-6xl justify-end gap-3 px-5 sm:px-8">
    <button type="button" class="gallery-paddle" data-gallery-step="-1" aria-label={t('gallery.prev')} disabled>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 3.5L5.5 8l4.5 4.5"></path>
      </svg>
    </button>
    <button type="button" class="gallery-paddle" data-gallery-step="1" aria-label={t('gallery.next')}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 3.5L10.5 8 6 12.5"></path>
      </svg>
    </button>
  </div>
</section>

<style>
  .gallery-rail {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* Line the first tile up with the column above, then let the row run
       off the edge of the window. */
    --gutter: max(1.25rem, calc((100vw - 72rem) / 2 + 2rem));
    scroll-padding-inline: var(--gutter);
  }

  .gallery-rail:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }

  .gallery-track {
    display: flex;
    gap: clamp(0.875rem, 1.6vw, 1.25rem);
    width: max-content;
    padding-inline: var(--gutter);
    padding-block: 0.5rem;
  }

  .gallery-tile {
    position: relative;
    overflow: hidden;
    flex: none;
    width: clamp(256px, 74vw, 372px);
    aspect-ratio: 372 / 628;
    border-radius: 2rem;
    scroll-snap-align: start;
    text-align: center;
    isolation: isolate;
  }

  .gallery-tile__copy {
    padding: 2.1rem 1.6rem 0;
  }

  .gallery-tile__title {
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .gallery-tile__caption {
    margin-top: 0.55rem;
    font-size: 1rem;
    line-height: 1.35;
    color: rgb(255 255 255 / 0.78);
    text-wrap: balance;
  }

  :is(:lang(ar), :lang(he), :lang(hi), :lang(ja), :lang(zh), :lang(hy)) .gallery-tile__title {
    letter-spacing: 0;
  }

  .gallery-tile :global(.gallery-tile__phone) {
    position: absolute;
    left: 50%;
    top: 31%;
    width: 78%;
    translate: -50% 0;
    transition: translate 0.8s var(--ease-out-soft);
  }

  @media (hover: hover) {
    .gallery-tile:hover :global(.gallery-tile__phone) {
      translate: -50% -10px;
    }
  }

  .gallery-paddle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink);
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }

  .dark .gallery-paddle {
    background: var(--surface);
  }

  .gallery-paddle:hover:not(:disabled) {
    background: var(--line);
  }

  .gallery-paddle:disabled {
    opacity: 0.38;
    cursor: default;
  }

  .gallery-paddle svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  :global([dir='rtl']) .gallery-paddle svg {
    transform: scaleX(-1);
  }
</style>

<script>
  // The two round buttons below the rail: one tile at a time, and greyed out
  // at either end. Right-to-left pages scroll the other way round.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((rail) => {
    const section = rail.closest('section');
    const buttons = [...(section?.querySelectorAll<HTMLButtonElement>('[data-gallery-step]') ?? [])];
    const rtl = getComputedStyle(rail).direction === 'rtl';

    const step = () => {
      const tile = rail.querySelector<HTMLElement>('li');
      const gap = parseFloat(getComputedStyle(rail.firstElementChild as HTMLElement).columnGap) || 0;
      return (tile?.offsetWidth ?? rail.clientWidth * 0.8) + gap;
    };

    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const at = Math.abs(rail.scrollLeft);
      for (const button of buttons) {
        const forward = Number(button.dataset.galleryStep) > 0;
        button.disabled = forward ? at >= max - 2 : at <= 2;
      }
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const direction = Number(button.dataset.galleryStep) * (rtl ? -1 : 1);
        const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        rail.scrollBy({ left: direction * step(), behavior: smooth ? 'smooth' : 'auto' });
      });
    }

    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
