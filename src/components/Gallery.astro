---
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { phoneScreen, type PhoneScreen } from '../i18n/screens';
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { home, shots } = getContent(lang);
// The seven App Store images, in App Store order, with their headlines.
---

<!-- A deliberately dark band: the light app screens carry the section. -->
<section
  id="gallery"
  class="relative scroll-mt-20 overflow-hidden bg-brand-950 py-20 text-white sm:py-28"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div
      class="absolute left-1/2 top-0 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-brand-600/25 blur-[120px]"
    >
    </div>
  </div>

  <div class="relative">
    <div class="mx-auto mb-12 max-w-6xl px-5 text-center sm:mb-16 sm:px-8">
      <h2 class="text-display text-3xl font-bold sm:text-[2.75rem]">{home.gallery.title}</h2>
      <p class="text-balance mx-auto mt-5 max-w-xl text-[17px] text-brand-100/75">
        {home.gallery.subtitle}
      </p>
    </div>

    <!-- Scroll rail: swipeable on touch, keyboard scrollable everywhere. -->
    <div
      class="snap-rail flex snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-4 sm:gap-8 sm:px-8"
      tabindex="0"
      role="group"
      aria-label={home.gallery.title}
    >
      <div aria-hidden="true" class="shrink-0 grow basis-0 sm:min-w-4"></div>
      {
        shots.map((s) => (
          <figure class="w-[210px] shrink-0 snap-center sm:w-[240px]">
            <DeviceFrame
              image={phoneScreen(lang, s.id as PhoneScreen)}
              alt={s.alt}
              sizes="(min-width: 640px) 240px, 210px"
              widths={[210, 240, 420, 480]}
            />
            <figcaption class="mt-5 text-center">
              <div class="text-[15px] font-semibold">{s.title}</div>
              <div class="mt-1 text-[13px] leading-relaxed text-brand-100/65">{s.caption}</div>
            </figcaption>
          </figure>
        ))
      }
      <div aria-hidden="true" class="shrink-0 grow basis-0 sm:min-w-4"></div>
    </div>
  </div>
</section>
