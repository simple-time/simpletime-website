---
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { audience } = getContent(lang).home;

const icons = [
  {
    key: 'work',
    icon: `<rect x="3" y="7.5" width="18" height="12.5" rx="2.2"/><path d="M8.5 7.5V5.6A1.6 1.6 0 0 1 10.1 4h3.8a1.6 1.6 0 0 1 1.6 1.6v1.9"/><path d="M3 12.5h18"/>`,
  },
  {
    key: 'study',
    icon: `<path d="M12 4L2.8 8.4 12 12.8l9.2-4.4L12 4z"/><path d="M6.4 10.6v4.6c0 .9 2.5 2.4 5.6 2.4s5.6-1.5 5.6-2.4v-4.6"/>`,
  },
  {
    key: 'training',
    icon: `<path d="M6.5 8.5v7"/><path d="M17.5 8.5v7"/><path d="M3.5 10.5v3"/><path d="M20.5 10.5v3"/><path d="M6.5 12h11"/>`,
  },
  {
    key: 'everyday',
    icon: `<path d="M3.5 11.2L12 4l8.5 7.2"/><path d="M5.8 9.6V19a1.2 1.2 0 0 0 1.2 1.2h10a1.2 1.2 0 0 0 1.2-1.2V9.6"/>`,
  },
] as const;

const groups = audience.groups.map((g) => ({ ...g, icon: icons.find((i) => i.key === g.id)?.icon ?? '' }));
---

<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="mb-12 max-w-3xl sm:mb-16">
      <h2 class="reveal t-section">{audience.title}</h2>
      <p class="reveal delay-1 t-intro mt-5 text-muted">{audience.subtitle}</p>
    </div>

    <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        groups.map((g, i) => (
          <div class:list={['reveal border-t border-line-strong pt-6', `delay-${i + 1}`]}>
            <svg
              class="h-7 w-7 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={g.icon}
            />
            <h3 class="mt-5 text-[19px] font-semibold tracking-[-0.015em]">{g.title}</h3>
            <p class="mt-2.5 text-[15.5px] leading-relaxed text-muted text-pretty">{g.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
