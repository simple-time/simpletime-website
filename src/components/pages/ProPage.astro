---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import AppStoreButton from '../AppStoreButton.astro';
import DeviceFrame from '../DeviceFrame.astro';
import WatchFrame from '../WatchFrame.astro';
import FaqEntry from '../FaqEntry.astro';
import CTA from '../CTA.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath, langPrefix } from '../../i18n/utils';
import { getContent, faqById, PRO_FAQ, TERMS_URL } from '../../i18n/content';
import { phoneScreen, watchScreen } from '../../i18n/screens';
import proMark from '../../assets/pro/mark.webp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { pro, shots } = getContent(lang);
const entries = faqById(lang);
const questions = PRO_FAQ.map((id) => entries.get(id)).filter((item) => item !== undefined);

// The eight colourways of the app icon, each with the Pro star – in the app's order.
const iconFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/pro/icon-*.webp', { eager: true });
const icons = ['standard', 'petrol', 'violet', 'slate', 'forest', 'burgundy', 'graphite', 'espresso'].map(
  (name) => iconFiles[`../../assets/pro/icon-${name}.webp`].default,
);

const featureIcons: Record<string, string> = {
  watch: `<rect x="6.5" y="5.5" width="11" height="13" rx="3.2"/><path d="M9 5.5l.6-2.5h4.8l.6 2.5M9 18.5l.6 2.5h4.8l.6-2.5"/><path d="M12 9.5V12l1.6 1"/>`,
  reviews: `<rect x="4" y="6.5" width="12.5" height="14" rx="2.2"/><path d="M7.5 3.5h10a2.5 2.5 0 0 1 2.5 2.5v11"/><path d="M7.5 11.5h5.5M7.5 15h3.5"/>`,
  places: `<path d="M12 21s-6.5-5.6-6.5-10.8a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z"/><circle cx="12" cy="10.2" r="2.4"/>`,
  year: `<rect x="3.5" y="3.5" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="3.5" width="4.5" height="4.5" rx="1"/><rect x="16" y="3.5" width="4.5" height="4.5" rx="1"/><rect x="3.5" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="16" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="3.5" y="16" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="16" width="4.5" height="4.5" rx="1"/>`,
  goals: `<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.6"/>`,
  focus: `<path d="M20 14.2A8.5 8.5 0 1 1 9.8 4a6.8 6.8 0 0 0 10.2 10.2z"/>`,
  widget: `<rect x="4" y="8" width="16" height="12.5" rx="2.5"/><path d="M6.5 5h11M8.5 2.5h7"/>`,
  style: `<path d="M12 3.5a8.5 8.5 0 0 0 0 17c1.3 0 1.9-.9 1.9-1.8 0-1.3-1-1.6-1-2.8 0-1 .8-1.7 1.8-1.7h2.2a3.6 3.6 0 0 0 3.6-3.6C20.5 6.9 16.7 3.5 12 3.5z"/><circle cx="7.8" cy="11" r="1.2"/><circle cx="10.5" cy="7.3" r="1.2"/><circle cx="15" cy="7.8" r="1.2"/>`,
  report: `<path d="M14 3.5H7a1.8 1.8 0 0 0-1.8 1.8v13.4A1.8 1.8 0 0 0 7 20.5h10a1.8 1.8 0 0 0 1.8-1.8V8.3z"/><path d="M14 3.5v4.8h4.8"/><path d="M8.8 17v-3M12 17v-5M15.2 17v-2"/>`,
  future: `<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v8M8.5 12.5L12 16l3.5-3.5"/>`,
};

const planIcons: Record<string, string> = {
  monthly: `<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>`,
  yearly: `<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="M8 13.5h8M8 16.5h5"/>`,
  lifetime: `<path d="M12 12c-2-2.7-3.7-4-5.6-4a4 4 0 0 0 0 8c1.9 0 3.6-1.3 5.6-4zm0 0c2 2.7 3.7 4 5.6 4a4 4 0 0 0 0-8c-1.9 0-3.6 1.3-5.6 4z"/>`,
};
const noteIcons = [
  `<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>`,
  `<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9.5" r="2.4"/><path d="M15.5 14.4a4.6 4.6 0 0 1 5 4.6"/>`,
  `<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v8M8.5 12.5L12 16l3.5-3.5"/>`,
];

const alt = (id: string) => shots.find((s) => s.id === id)?.alt ?? '';
---

<Layout
  lang={lang}
  path={getLocalizedPath(lang, '/pro/')}
  title={t('meta.pro.title')}
  description={t('meta.pro.description')}
>
  <section class="pro-hero brand-night relative overflow-hidden">
    <div class="mx-auto max-w-4xl px-5 pt-14 text-center sm:px-8 sm:pt-20">
      <Image
        src={proMark}
        alt=""
        width={88}
        height={88}
        widths={[88, 176]}
        sizes="88px"
        loading="eager"
        class="rise mx-auto h-[76px] w-[76px] rounded-[22.5%] shadow-[0_18px_40px_-14px_rgb(0_0_0/0.75)] ring-1 ring-white/10 sm:h-[88px] sm:w-[88px]"
      />
      <p class="rise delay-1 mt-7 text-[19px] font-semibold tracking-[-0.01em] text-[#9dbcff]">{pro.eyebrow}</p>
      <h1 class="rise delay-2 t-hero mt-3">{pro.title}</h1>
      <p class="rise delay-3 t-intro mx-auto mt-6 max-w-2xl text-white/75">{pro.subtitle}</p>
      <div class="rise delay-4 mt-9 flex justify-center">
        <AppStoreButton label={t('appstore.download')} variant="onAccent" size="lg" />
      </div>
    </div>

    <div class="pro-hero__stage rise-media delay-3" dir="ltr">
      <div class="pro-hero__glow" aria-hidden="true"></div>
      <WatchFrame image={watchScreen(lang, 'start')} alt="" class="pro-hero__watch pro-hero__watch--left" finish="silver" sizes="190px" loading="eager" />
      <DeviceFrame
        image={phoneScreen(lang, 'pro')}
        alt={alt('pro')}
        loading="eager"
        finish="black"
        class="pro-hero__phone"
        sizes="(min-width: 1024px) 320px, 60vw"
        widths={[240, 320, 480, 640]}
      />
      <WatchFrame image={watchScreen(lang, 'running')} alt="" class="pro-hero__watch pro-hero__watch--right" sizes="210px" loading="eager" />
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <h2 class="reveal t-section mb-12 max-w-3xl sm:mb-16">{pro.featuresTitle}</h2>
      <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          pro.features.map((feature, i) => (
            <div class:list={['reveal border-t border-line-strong pt-6', `delay-${(i % 3) + 1}`]}>
              <svg
                class="h-7 w-7 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={featureIcons[feature.id]}
              />
              <h3 class="mt-5 text-[19px] font-semibold tracking-[-0.015em]">{feature.title}</h3>
              <p class="mt-2.5 text-[15.5px] leading-relaxed text-muted text-pretty">{feature.body}</p>
              {feature.id === 'style' && (
                <div class="mt-5 flex flex-wrap gap-2" aria-hidden="true">
                  {icons.map((icon) => (
                    <Image
                      src={icon}
                      alt=""
                      width={32}
                      height={32}
                      widths={[32, 64]}
                      sizes="32px"
                      class="h-8 w-8 rounded-[22.5%] shadow-[0_4px_10px_-4px_rgb(0_0_0/0.35)] ring-1 ring-black/5 dark:ring-white/10"
                    />
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="plans" class="scroll-mt-14 bg-canvas-alt py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center sm:mb-16">
        <h2 class="reveal t-section">{pro.plansTitle}</h2>
        <p class="reveal delay-1 t-intro mt-5 text-muted">{pro.plansSubtitle}</p>
      </div>

      <div class="grid gap-4 md:grid-cols-3 lg:gap-5">
        {
          pro.plans.map((plan, i) => (
            <div
              class:list={[
                'reveal plan-card',
                `delay-${i + 1}`,
                plan.id === 'yearly' && 'plan-card--featured',
              ]}
            >
              <svg
                class="h-8 w-8 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={planIcons[plan.id]}
              />
              <h3 class="mt-6 text-[24px] font-bold tracking-[-0.022em]">{plan.title}</h3>
              <p class="mt-3 text-[15.5px] leading-relaxed text-muted text-pretty">{plan.body}</p>
            </div>
          ))
        }
      </div>

      <ul class="reveal mt-12 grid gap-6 sm:grid-cols-3">
        {
          pro.notes.map((note, i) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-ink">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={noteIcons[i]}
              />
              <span>{note}</span>
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-12 border-t border-line-strong pt-6 text-center text-[13px] leading-relaxed text-muted">
        <p class="mx-auto max-w-2xl">{pro.legal}</p>
        <p class="mt-3 flex flex-wrap justify-center gap-x-6 gap-y-2">
          <a href={TERMS_URL} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">{pro.terms}</a>
          <a href={`${langPrefix(lang)}/privacy/`} class="font-medium text-accent hover:underline">{pro.privacy}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="mx-auto grid max-w-6xl gap-4 px-5 sm:px-8 md:grid-cols-2 lg:gap-5">
      <div class="reveal rounded-[1.75rem] bg-canvas-alt p-8 sm:p-10 dark:bg-surface">
        <h2 class="t-title">{pro.freeTitle}</h2>
        <p class="mt-5 text-[16px] leading-relaxed text-muted text-pretty">{pro.freeBody}</p>
      </div>
      <div class="reveal delay-1 rounded-[1.75rem] bg-canvas-alt p-8 sm:p-10 dark:bg-surface">
        <h2 class="t-title">{pro.howTitle}</h2>
        <ol class="mt-6 space-y-4">
          {
            pro.how.map((step, i) => (
              <li class="flex gap-4 text-[16px] leading-relaxed text-muted">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-action text-[13px] font-semibold text-on-action">
                  {i + 1}
                </span>
                <span class="pt-0.5">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-canvas-alt py-20 sm:py-28">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 sm:px-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <h2 class="reveal t-section lg:sticky lg:top-24 lg:self-start">{pro.faqTitle}</h2>
      <div class="reveal delay-1 divide-y divide-line-strong border-y border-line-strong">
        {questions.map((item) => <FaqEntry lang={lang} item={item} />)}
      </div>
    </div>
  </section>

  <CTA lang={lang} title={pro.ctaTitle} subtitle={pro.ctaSubtitle} note="" />
</Layout>

<style>
  .pro-hero__stage {
    --pw: min(56vw, 250px);
    position: relative;
    height: calc(var(--pw) * 2.105 * 0.74);
    margin-top: clamp(3rem, 6vw, 4.5rem);
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .pro-hero__stage {
      --pw: 300px;
    }
  }

  .pro-hero__glow {
    position: absolute;
    left: 50%;
    top: 10%;
    width: min(52rem, 140vw);
    height: 90%;
    translate: -50% 0;
    background: radial-gradient(50% 50% at 50% 50%, rgb(61 120 255 / 0.34), transparent 70%);
  }

  .pro-hero__stage :global(.pro-hero__phone) {
    position: absolute;
    z-index: 2;
    left: calc(50% - var(--pw) / 2);
    top: 0;
    width: var(--pw);
  }

  .pro-hero__stage :global(.pro-hero__watch) {
    position: absolute;
    z-index: 3;
    width: calc(var(--pw) * 0.62);
    top: calc(var(--pw) * 0.62);
  }

  .pro-hero__stage :global(.pro-hero__watch--left) {
    left: calc(50% - var(--pw) * 1.08);
    width: calc(var(--pw) * 0.54);
    top: calc(var(--pw) * 0.82);
    z-index: 1;
  }

  .pro-hero__stage :global(.pro-hero__watch--right) {
    left: calc(50% + var(--pw) * 0.42);
  }

  @media (max-width: 639px) {
    .pro-hero__stage :global(.pro-hero__watch--left) {
      display: none;
    }

    .pro-hero__stage :global(.pro-hero__watch--right) {
      left: calc(50% + var(--pw) * 0.18);
      width: calc(var(--pw) * 0.56);
      top: calc(var(--pw) * 0.92);
    }
  }

  .plan-card {
    border-radius: 1.75rem;
    background: var(--surface);
    padding: 2rem 2rem 2.25rem;
    box-shadow: 0 0 0 1px var(--line);
  }

  .plan-card--featured {
    box-shadow:
      0 0 0 2px var(--action),
      0 30px 60px -36px rgb(36 87 214 / 0.55);
  }
</style>
