---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import AppStoreButton from '../AppStoreButton.astro';
import DeviceFrame from '../DeviceFrame.astro';
import WatchFrame from '../WatchFrame.astro';
import FaqEntry from '../FaqEntry.astro';
import CTA from '../CTA.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath, langPrefix } from '../../i18n/utils';
import { getContent, faqById, PRO_FAQ, TERMS_URL } from '../../i18n/content';
import { phoneScreen, watchScreen } from '../../i18n/screens';
import proMark from '../../assets/pro/mark.webp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { pro, shots } = getContent(lang);
const entries = faqById(lang);
const questions = PRO_FAQ.map((id) => entries.get(id)).filter((item) => item !== undefined);

// The eight colourways of the app icon, each with the Pro star – in the app's order.
const iconFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/pro/icon-*.webp', { eager: true });
const icons = ['standard', 'petrol', 'violet', 'slate', 'forest', 'burgundy', 'graphite', 'espresso'].map(
  (name) => iconFiles[`../../assets/pro/icon-${name}.webp`].default,
);

const featureIcons: Record<string, string> = {
  watch: `<rect x="6.5" y="5.5" width="11" height="13" rx="3.2"/><path d="M9 5.5l.6-2.5h4.8l.6 2.5M9 18.5l.6 2.5h4.8l.6-2.5"/><path d="M12 9.5V12l1.6 1"/>`,
  reviews: `<rect x="4" y="6.5" width="12.5" height="14" rx="2.2"/><path d="M7.5 3.5h10a2.5 2.5 0 0 1 2.5 2.5v11"/><path d="M7.5 11.5h5.5M7.5 15h3.5"/>`,
  places: `<path d="M12 21s-6.5-5.6-6.5-10.8a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z"/><circle cx="12" cy="10.2" r="2.4"/>`,
  year: `<rect x="3.5" y="3.5" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="3.5" width="4.5" height="4.5" rx="1"/><rect x="16" y="3.5" width="4.5" height="4.5" rx="1"/><rect x="3.5" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="16" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="3.5" y="16" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="16" width="4.5" height="4.5" rx="1"/>`,
  goals: `<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.6"/>`,
  focus: `<path d="M20 14.2A8.5 8.5 0 1 1 9.8 4a6.8 6.8 0 0 0 10.2 10.2z"/>`,
  widget: `<rect x="4" y="8" width="16" height="12.5" rx="2.5"/><path d="M6.5 5h11M8.5 2.5h7"/>`,
  style: `<path d="M12 3.5a8.5 8.5 0 0 0 0 17c1.3 0 1.9-.9 1.9-1.8 0-1.3-1-1.6-1-2.8 0-1 .8-1.7 1.8-1.7h2.2a3.6 3.6 0 0 0 3.6-3.6C20.5 6.9 16.7 3.5 12 3.5z"/><circle cx="7.8" cy="11" r="1.2"/><circle cx="10.5" cy="7.3" r="1.2"/><circle cx="15" cy="7.8" r="1.2"/>`,
  report: `<path d="M14 3.5H7a1.8 1.8 0 0 0-1.8 1.8v13.4A1.8 1.8 0 0 0 7 20.5h10a1.8 1.8 0 0 0 1.8-1.8V8.3z"/><path d="M14 3.5v4.8h4.8"/><path d="M8.8 17v-3M12 17v-5M15.2 17v-2"/>`,
  future: `<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v8M8.5 12.5L12 16l3.5-3.5"/>`,
};

const planIcons: Record<string, string> = {
  monthly: `<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>`,
  yearly: `<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="M8 13.5h8M8 16.5h5"/>`,
  lifetime: `<path d="M12 12c-2-2.7-3.7-4-5.6-4a4 4 0 0 0 0 8c1.9 0 3.6-1.3 5.6-4zm0 0c2 2.7 3.7 4 5.6 4a4 4 0 0 0 0-8c-1.9 0-3.6 1.3-5.6 4z"/>`,
};
const noteIcons = [
  `<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>`,
  `<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9.5" r="2.4"/><path d="M15.5 14.4a4.6 4.6 0 0 1 5 4.6"/>`,
  `<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v8M8.5 12.5L12 16l3.5-3.5"/>`,
];

const alt = (id: string) => shots.find((s) => s.id === id)?.alt ?? '';
---

<Layout
  lang={lang}
  path={getLocalizedPath(lang, '/pro/')}
  title={t('meta.pro.title')}
  description={t('meta.pro.description')}
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="absolute inset-x-0 top-0 h-[620px] bg-gradient-to-b from-brand-50 via-canvas to-canvas dark:from-brand-950/60 dark:via-canvas dark:to-canvas"
      >
      </div>
      <div
        class="absolute -top-32 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-brand-200/30 blur-[130px] dark:bg-brand-700/20"
      >
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-5 pb-16 pt-14 sm:px-8 sm:pb-24 sm:pt-20">
      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8">
        <div class="reveal text-center lg:text-start">
          <Image
            src={proMark}
            alt=""
            width={80}
            height={80}
            widths={[80, 160]}
            sizes="80px"
            loading="eager"
            class="mx-auto h-20 w-20 rounded-[22%] shadow-lift ring-1 ring-black/5 lg:mx-0 dark:ring-white/10"
          />
          <p class="mt-7 text-[13px] font-semibold uppercase tracking-[0.14em] text-brand-600 dark:text-brand-300">
            {pro.eyebrow}
          </p>
          <h1 class="text-display mt-4 text-[2.5rem] font-bold sm:text-5xl lg:text-[3.5rem]">{pro.title}</h1>
          <p class="text-balance mx-auto mt-6 max-w-xl text-[17px] leading-relaxed text-muted sm:text-lg lg:mx-0">
            {pro.subtitle}
          </p>
          <div class="mt-9 flex justify-center lg:justify-start">
            <AppStoreButton label={t('appstore.download')} size="lg" />
          </div>
        </div>

        <div class="reveal relative mx-auto w-full max-w-[340px]" data-reveal-delay="120">
          <div
            aria-hidden="true"
            class="absolute inset-x-4 top-10 -z-10 h-3/4 rounded-full bg-brand-400/25 blur-[70px] dark:bg-brand-500/25"
          >
          </div>
          <DeviceFrame
            image={phoneScreen(lang, 'pro')}
            alt={alt('pro')}
            loading="eager"
            class="ms-auto w-[78%]"
            sizes="(min-width: 640px) 265px, 60vw"
            widths={[240, 280, 480, 560]}
          />
          <WatchFrame
            image={watchScreen(lang, 'running')}
            alt=""
            class="absolute bottom-6 start-0 w-[42%]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-canvas-alt py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <h2 class="reveal text-display mx-auto mb-14 max-w-2xl text-center text-3xl font-bold sm:text-[2.75rem]">
        {pro.featuresTitle}
      </h2>
      <div class="flex flex-wrap justify-center gap-4">
        {
          pro.features.map((feature, i) => (
            <div
              class="reveal w-full rounded-3xl border border-line bg-surface p-7 sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.667rem)]"
              data-reveal-delay={String((i % 3) * 70)}
            >
              <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 dark:bg-brand-700/25 dark:text-brand-200">
                <svg
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={featureIcons[feature.id]}
                />
              </div>
              <h3 class="text-[17px] font-semibold tracking-tight">{feature.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{feature.body}</p>
              {feature.id === 'style' && (
                <div class="mt-5 flex flex-wrap gap-1.5" aria-hidden="true">
                  {icons.map((icon) => (
                    <Image
                      src={icon}
                      alt=""
                      width={28}
                      height={28}
                      widths={[28, 56]}
                      sizes="28px"
                      class="h-7 w-7 rounded-[22%] ring-1 ring-black/5 dark:ring-white/10"
                    />
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="plans" class="scroll-mt-20 py-20 sm:py-28">
    <div class="mx-auto max-w-5xl px-5 sm:px-8">
      <div class="reveal mx-auto mb-14 max-w-2xl text-center">
        <h2 class="text-display text-3xl font-bold sm:text-[2.75rem]">{pro.plansTitle}</h2>
        <p class="text-balance mt-5 text-[17px] leading-relaxed text-muted">{pro.plansSubtitle}</p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {
          pro.plans.map((plan) => (
            <div
              class:list={[
                'reveal rounded-3xl border bg-surface p-7',
                plan.id === 'yearly' ? 'border-accent ring-1 ring-accent' : 'border-line',
              ]}
            >
              <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 dark:bg-brand-700/25 dark:text-brand-200">
                <svg
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={planIcons[plan.id]}
                />
              </div>
              <h3 class="text-xl font-semibold tracking-tight">{plan.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{plan.body}</p>
            </div>
          ))
        }
      </div>

      <ul class="reveal mt-10 grid gap-4 sm:grid-cols-3">
        {
          pro.notes.map((note, i) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-ink">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-brand-500 dark:text-brand-300"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={noteIcons[i]}
              />
              <span>{note}</span>
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-10 border-t border-line pt-6 text-center text-[13px] leading-relaxed text-subtle">
        <p class="mx-auto max-w-2xl">{pro.legal}</p>
        <p class="mt-3 flex flex-wrap justify-center gap-x-6 gap-y-2">
          <a href={TERMS_URL} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">{pro.terms}</a>
          <a href={`${langPrefix(lang)}/privacy/`} class="font-medium text-accent hover:underline">{pro.privacy}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="bg-canvas-alt py-20 sm:py-24">
    <div class="mx-auto grid max-w-5xl gap-4 px-5 sm:px-8 md:grid-cols-2">
      <div class="reveal rounded-3xl border border-line bg-surface p-8">
        <h2 class="text-2xl font-bold tracking-tight">{pro.freeTitle}</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">{pro.freeBody}</p>
      </div>
      <div class="reveal rounded-3xl border border-line bg-surface p-8" data-reveal-delay="70">
        <h2 class="text-2xl font-bold tracking-tight">{pro.howTitle}</h2>
        <ol class="mt-5 space-y-4">
          {
            pro.how.map((step, i) => (
              <li class="flex gap-4 text-[15px] leading-relaxed text-muted">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-accent text-[13px] font-semibold text-on-accent">
                  {i + 1}
                </span>
                <span class="pt-0.5">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="reveal text-display mb-12 text-center text-3xl font-bold sm:text-[2.5rem]">{pro.faqTitle}</h2>
      <div class="reveal divide-y divide-line overflow-hidden rounded-3xl border border-line bg-surface">
        {questions.map((item) => <FaqEntry lang={lang} item={item} />)}
      </div>
    </div>
  </section>

  <CTA lang={lang} title={pro.ctaTitle} subtitle={pro.ctaSubtitle} note="" />
</Layout>
