---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import RichText from '../RichText.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath, CONTACT_EMAIL } from '../../i18n/utils';
import { getContent } from '../../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { privacy } = getContent(lang);

// Bump when the policy's content changes – the date is part of the policy.
const lastUpdated = '2026-09-30';

const DATE_LOCALE: Record<Lang, string> = {
  en: 'en-US', de: 'de-DE', nl: 'nl-NL', sv: 'sv-SE', fr: 'fr-FR', it: 'it-IT', es: 'es-ES',
  pt: 'pt-PT', ru: 'ru-RU', uk: 'uk-UA', el: 'el-GR', tr: 'tr-TR', hy: 'hy-AM', ar: 'ar',
  he: 'he-IL', hi: 'hi-IN', zh: 'zh-CN', ja: 'ja-JP',
};
const formatted = new Date(lastUpdated).toLocaleDateString(DATE_LOCALE[lang], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout
  lang={lang}
  path={getLocalizedPath(lang, '/privacy/')}
  title={`${privacy.title} · SimpleTime`}
  description={t('meta.privacy.description')}
>
  <PageHeader title={privacy.title} />

  <article class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="text-sm text-subtle">{privacy.updated}: {formatted}</p>

    {
      lang !== 'de' && (
        <p class="mt-3 text-sm text-subtle">
          <RichText text={privacy.translationNote} lang={lang} />
        </p>
      )
    }

    <div class="mt-8 rounded-3xl border border-line bg-canvas-alt p-6 sm:p-8">
      <h2 class="text-lg font-semibold text-ink">{privacy.summaryTitle}</h2>
      <ul class="mt-4 space-y-3">
        {
          privacy.summary.map((point) => (
            <li class="flex gap-3 leading-relaxed text-muted">
              <svg
                class="mt-1 h-4 w-4 shrink-0 text-brand-500 dark:text-brand-300"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4.5 12.5l4.5 4.5L19.5 6.5" />
              </svg>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="mt-8" aria-label={privacy.title}>
      <ol class="flex flex-wrap gap-x-5 gap-y-2 text-[15px]">
        {
          privacy.sections.map((section) => (
            <li>
              <a href={`#${section.id}`} class="text-accent hover:underline">
                {section.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      privacy.sections.map((section) => (
        <section id={section.id} class="scroll-mt-24">
          <h2 class="mt-12 text-xl font-semibold text-ink">{section.title}</h2>
          {'paragraphs' in section &&
            section.paragraphs?.map((paragraph) => (
              <p class="mt-3 leading-relaxed text-muted">
                <RichText text={paragraph} lang={lang} />
              </p>
            ))}
          {'address' in section && section.address && (
            <p class="mt-3 leading-relaxed text-muted">
              Luca Efinger
              <br />
              Friedrich-Ebert-Ring 16
              <br />
              97072 Würzburg
              <br />
              {t('imprint.country')}
              <br />
              <a href={`mailto:${CONTACT_EMAIL}`} class="text-accent hover:underline">
                {CONTACT_EMAIL}
              </a>
            </p>
          )}
          {'subsections' in section &&
            section.subsections?.map((sub) => (
              <>
                <h3 class="mt-7 text-lg font-semibold text-ink">{sub.title}</h3>
                {sub.paragraphs.map((paragraph) => (
                  <p class="mt-3 leading-relaxed text-muted">
                    <RichText text={paragraph} lang={lang} />
                  </p>
                ))}
              </>
            ))}
        </section>
      ))
    }
  </article>
</Layout>
