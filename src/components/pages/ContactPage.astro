---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath, langPrefix, CONTACT_EMAIL } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  path={getLocalizedPath(lang, '/contact/')}
  title={`${t('contact.title')} · SimpleTime`}
  description={t('meta.contact.description')}
>
  <PageHeader title={t('contact.title')} subtitle={t('contact.subtitle')} />

  <section class="mx-auto max-w-2xl px-5 pb-24 pt-4 sm:px-8">
    <div class="reveal rounded-[1.75rem] bg-canvas-alt p-8 text-center sm:p-12 dark:bg-surface">
      <h2 class="text-[17px] font-semibold text-ink">{t('contact.email.label')}</h2>
      <p class="mx-auto mt-3 max-w-md text-[16px] leading-relaxed text-muted">{t('contact.email.body')}</p>

      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="mt-7 inline-flex items-center gap-2.5 break-all text-[22px] font-semibold tracking-[-0.02em] text-accent transition-colors hover:text-accent-hover sm:text-[28px]"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <polyline points="3 7 12 13 21 7"></polyline>
        </svg>
        {CONTACT_EMAIL}
      </a>

      <p class="mx-auto mt-8 max-w-md text-[14px] leading-relaxed text-muted">{t('contact.response')}</p>
    </div>

    <p class="mt-8 text-center text-[15px] text-muted">
      {t('contact.faq')}
      {' '}
      <a href={`${langPrefix(lang)}/faq/`} class="font-medium text-accent hover:underline">{t('contact.faq.link')}</a>
    </p>
  </section>
</Layout>
