---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath, langPrefix, CONTACT_EMAIL } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  path={getLocalizedPath(lang, '/contact/')}
  title={`${t('contact.title')} · SimpleTime`}
  description={t('meta.contact.description')}
>
  <PageHeader title={t('contact.title')} subtitle={t('contact.subtitle')} />

  <section class="mx-auto max-w-2xl px-5 py-20 sm:px-8">
    <div class="rounded-3xl border border-line bg-surface p-8 sm:p-10">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-accent">{t('contact.email.label')}</h2>
      <p class="mt-3 leading-relaxed text-muted">{t('contact.email.body')}</p>

      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="mt-6 inline-flex items-center gap-2 break-all text-xl font-semibold text-accent transition-colors hover:text-accent-hover sm:text-2xl"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <polyline points="3 7 12 13 21 7"></polyline>
        </svg>
        {CONTACT_EMAIL}
      </a>

      <p class="mt-8 text-sm leading-relaxed text-subtle">{t('contact.response')}</p>
    </div>

    <p class="mt-8 text-center text-[15px] text-muted">
      {t('contact.faq')}
      {' '}
      <a href={`${langPrefix(lang)}/faq/`} class="font-medium text-accent hover:underline">{t('contact.faq.link')}</a>
    </p>
  </section>
</Layout>
