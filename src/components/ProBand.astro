---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { langPrefix } from '../i18n/utils';
import { getContent } from '../i18n/content';
import { watchScreen } from '../i18n/screens';
import WatchFrame from './WatchFrame.astro';
import proMark from '../assets/pro/mark.webp';

interface Props {
  lang: Lang;
}

// The Pro part of the App Store description, as it stands there – on the
// dark blue of the night, with the Apple Watch it brings.
const { lang } = Astro.props;
const { home, store } = getContent(lang);
const pro = store.pro;

// The eight colourways of the app icon, each with the Pro star – in the app's order.
const iconFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/pro/icon-*.webp', { eager: true });
const icons = ['standard', 'petrol', 'violet', 'slate', 'forest', 'burgundy', 'graphite', 'espresso'].map(
  (name) => iconFiles[`../assets/pro/icon-${name}.webp`].default,
);
---

<section id="pro" class="pro-band brand-night scroll-mt-14 overflow-hidden">
  <div class="mx-auto max-w-6xl px-5 pb-20 pt-20 sm:px-8 sm:pb-28 sm:pt-28">
    <div class="mx-auto max-w-3xl text-center">
      <Image
        src={proMark}
        alt=""
        width={84}
        height={84}
        widths={[84, 168]}
        sizes="84px"
        class="reveal mx-auto h-[84px] w-[84px] rounded-[22.5%] shadow-[0_18px_40px_-14px_rgb(0_0_0/0.7)] ring-1 ring-white/10"
      />
      <h2 class="reveal delay-1 t-section mt-8">{pro.title}</h2>
      <p class="reveal delay-2 t-intro mt-5 text-white/75">{pro.intro}</p>
    </div>

    <div class="pro-stage reveal-media delay-2" dir="ltr">
      <div class="pro-stage__glow" aria-hidden="true"></div>
      <WatchFrame image={watchScreen(lang, 'start')} alt="" class="pro-watch pro-watch--side" finish="silver" sizes="200px" />
      <WatchFrame image={watchScreen(lang, 'running')} alt="" class="pro-watch pro-watch--main" sizes="260px" />
    </div>

    <ul class="pro-points mt-14 sm:mt-20">
      {
        pro.points.map((point, i) => (
          <li class:list={['reveal', `delay-${(i % 3) + 1}`]}>
            <svg class="pro-points__star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.5l2.4 6.1 6.1 2.4-6.1 2.4-2.4 6.1-2.4-6.1L3.5 11l6.1-2.4z" />
            </svg>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-16 flex flex-wrap justify-center gap-3 sm:gap-4" aria-hidden="true">
      {
        icons.map((icon) => (
          <Image
            src={icon}
            alt=""
            width={56}
            height={56}
            widths={[56, 112]}
            sizes="56px"
            class="pro-icon h-12 w-12 rounded-[22.5%] ring-1 ring-white/10 sm:h-14 sm:w-14"
          />
        ))
      }
    </div>

    <div class="mx-auto mt-14 max-w-2xl text-center">
      <p class="reveal text-[15px] leading-relaxed text-white/70 text-pretty">{pro.pricing}</p>
      <a href={`${langPrefix(lang)}/pro/`} class="reveal delay-1 btn btn--light mt-8">
        {home.pro.button}
        <svg class="h-3 w-3 rtl:-scale-x-100" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 2.5L8 6l-3.5 3.5"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .pro-stage {
    position: relative;
    height: clamp(20rem, 46vw, 30rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .pro-stage__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(46rem, 120vw);
    height: 120%;
    translate: -50% -50%;
    background: radial-gradient(50% 50% at 50% 50%, rgb(61 120 255 / 0.32), transparent 70%);
  }

  .pro-stage :global(.pro-watch) {
    position: absolute;
    top: 50%;
  }

  .pro-stage :global(.pro-watch--main) {
    z-index: 2;
    width: clamp(10.5rem, 22vw, 15rem);
    left: 50%;
    translate: -38% -50%;
  }

  .pro-stage :global(.pro-watch--side) {
    z-index: 1;
    width: clamp(8rem, 16vw, 11rem);
    left: 50%;
    translate: -118% -46%;
    opacity: 0.92;
  }

  .pro-points {
    display: grid;
    gap: 1.1rem 2.5rem;
    max-width: 64rem;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .pro-points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .pro-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pro-points li {
    display: flex;
    gap: 0.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.97rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.86);
  }

  .pro-points__star {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.2rem;
    color: #8eb4ff;
  }

  .pro-icon {
    box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.7);
  }
</style>
