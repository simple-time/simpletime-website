---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute inset-0 bg-gradient-to-b from-brand-50 to-canvas dark:from-brand-950/60 dark:to-canvas"
    >
    </div>
    <div
      class="absolute -top-40 left-1/2 h-[400px] w-[760px] -translate-x-1/2 rounded-full bg-brand-200/35 blur-[120px] dark:bg-brand-700/20"
    >
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-5 pb-16 pt-16 text-center sm:px-8 sm:pb-20 sm:pt-20">
    <h1 class="text-display text-4xl font-bold sm:text-5xl">{title}</h1>
    {
      subtitle && (
        <p class="text-balance mx-auto mt-5 max-w-xl text-[17px] leading-relaxed text-muted">
          {subtitle}
        </p>
      )
    }
  </div>
</section>
