---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="page-header relative overflow-hidden">
  <div class="page-header__glow" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-4xl px-5 pb-8 pt-16 text-center sm:px-8 sm:pb-12 sm:pt-24">
    <h1 class="reveal t-section">{title}</h1>
    {
      subtitle && (
        <p class="reveal delay-1 t-intro mx-auto mt-5 max-w-2xl text-muted">
          {subtitle}
        </p>
      )
    }
  </div>
</section>

<style>
  .page-header__glow {
    position: absolute;
    left: 50%;
    top: -30%;
    width: min(56rem, 140vw);
    height: 120%;
    translate: -50% 0;
    background: radial-gradient(50% 50% at 50% 50%, var(--glow), transparent 72%);
  }
</style>
