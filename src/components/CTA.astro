---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getContent } from '../i18n/content';
import AppStoreButton from './AppStoreButton.astro';

interface Props {
  lang: Lang;
  /** Defaults to the home page's closing words; the Pro page brings its own. */
  title?: string;
  subtitle?: string;
  note?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { cta } = getContent(lang).home;
const { title = cta.title, subtitle = cta.subtitle, note = cta.note } = Astro.props;
---

<section class="cta relative overflow-hidden px-5 py-24 text-center sm:px-8 sm:py-32">
  <div class="cta__glow" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-3xl">
    <img src="/logo.png" alt="" width="112" height="112" class="reveal cta__icon mx-auto h-24 w-24 rounded-[22.5%] sm:h-28 sm:w-28" />
    <h2 class="reveal delay-1 t-section mt-9">{title}</h2>
    <p class="reveal delay-2 t-intro mx-auto mt-5 max-w-xl text-muted">{subtitle}</p>
    <div class="reveal delay-3 mt-10 flex justify-center">
      <AppStoreButton label={t('appstore.download')} size="lg" />
    </div>
    {note && <p class="reveal delay-4 mt-7 text-[14px] text-muted">{note}</p>}
  </div>
</section>

<style>
  .cta__glow {
    position: absolute;
    left: 50%;
    top: 0;
    width: min(60rem, 140vw);
    height: 70%;
    translate: -50% 0;
    background: radial-gradient(50% 50% at 50% 35%, var(--glow), transparent 72%);
  }

  .cta__icon {
    box-shadow:
      0 2px 4px rgb(10 22 60 / 0.12),
      0 24px 50px -16px rgb(10 22 60 / 0.5);
  }
</style>
