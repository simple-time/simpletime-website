---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import AppStoreButton from './AppStoreButton.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="px-5 py-20 sm:px-8 sm:py-24">
  <div
    class="reveal relative mx-auto max-w-5xl overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-brand-800 via-brand-700 to-brand-600 px-6 py-16 text-center text-white sm:px-12 sm:py-20"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div
        class="absolute -top-24 left-1/2 h-[380px] w-[600px] -translate-x-1/2 rounded-full bg-brand-400/30 blur-[100px]"
      >
      </div>
    </div>

    <div class="relative">
      <img
        src="/logo.png"
        alt=""
        width="64"
        height="64"
        class="mx-auto mb-7 h-16 w-16 rounded-[22%] shadow-lg ring-1 ring-white/15"
      />
      <h2 class="text-display text-3xl font-bold sm:text-[2.75rem]">{t('cta.title')}</h2>
      <p class="text-balance mx-auto mt-5 max-w-lg text-[17px] text-white/85">
        {t('cta.subtitle')}
      </p>
      <div class="mt-9 flex justify-center">
        <AppStoreButton label={t('cta.button')} variant="onAccent" size="lg" />
      </div>
      <p class="mt-6 text-[13px] text-brand-100/85">{t('hero.availability')}</p>
    </div>
  </div>
</section>
