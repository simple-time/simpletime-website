---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Rendered width hints for the responsive srcset. */
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  /** Colour of the band: silver, the icon's deep blue, or black. */
  finish?: 'silver' | 'blue' | 'black';
  class?: string;
}

const {
  image,
  alt,
  sizes = '(min-width: 1024px) 320px, 70vw',
  widths = [280, 400, 560, 720],
  loading = 'lazy',
  finish = 'silver',
  class: className = '',
} = Astro.props;

// The screens are prepared at the true 1320:2868 ratio by
// scripts/prepare-screens.py, so the frame needs no aspect fixing here.
// Its drawing lives in src/styles/devices.css.
---

<div class:list={['iphone', finish !== 'silver' && `iphone--${finish}`, className]}>
  <span class="iphone__key iphone__key--action" aria-hidden="true"></span>
  <span class="iphone__key iphone__key--up" aria-hidden="true"></span>
  <span class="iphone__key iphone__key--down" aria-hidden="true"></span>
  <span class="iphone__key iphone__key--side" aria-hidden="true"></span>
  <span class="iphone__key iphone__key--camera" aria-hidden="true"></span>
  <div class="iphone__body">
    <div class="iphone__glass">
      <div class="iphone__screen">
        <Image
          src={image}
          alt={alt}
          widths={widths}
          sizes={sizes}
          loading={loading}
          fetchpriority={loading === 'eager' ? 'high' : undefined}
          decoding="async"
        />
        <span class="iphone__island" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>
