---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Rendered width hints for the responsive srcset. */
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  alt,
  sizes = '(min-width: 1024px) 320px, 70vw',
  widths = [280, 400, 560, 720],
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

{/*
  Corner radii are in `cqw` (percent of the frame's own width), not `%`.
  A percentage border-radius resolves horizontally against width and
  vertically against height, which on a tall element produces elliptical
  corners. The radii below are concentric: outer = screen + bezel, with
  the screen at iOS's 12.5% of screen width.

  The screens are prepared at the true 1320:2868 ratio by
  scripts/prepare-screens.py, so the frame needs no aspect fixing here.
*/}
<div class={`@container relative ${className}`}>
  <div
    class="relative rounded-[14.2cqw] bg-[#0c0d10] p-[2.2cqw] shadow-device ring-1 ring-black/20 dark:ring-white/10"
  >
    {/* Polished titanium edge catching light from the top left. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 rounded-[14.2cqw] bg-gradient-to-br from-white/25 via-white/5 to-white/15"
    >
    </div>
    {/* Hairline where the glass meets the band. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-[1.4cqw] rounded-[12.8cqw] ring-1 ring-black/60"
    >
    </div>

    <div class="relative overflow-hidden rounded-[12cqw] bg-white">
      <Image
        src={image}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding="async"
        class="block h-auto w-full"
      />
    </div>
  </div>
</div>
