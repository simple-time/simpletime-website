---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Rendered width hints for the responsive srcset. */
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  alt,
  sizes = '(min-width: 1024px) 320px, 70vw',
  widths = [280, 400, 560, 720],
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

<!--
  The screenshots already include the iOS status bar and Dynamic Island,
  so the frame only supplies the bezel, the titanium edge and the shadow.
-->
<div class={`relative ${className}`}>
  <div
    class="relative rounded-[13%] bg-slate-950 p-[2.2%] shadow-device ring-1 ring-white/12 dark:ring-white/10"
  >
    <!-- Brushed metal edge -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 rounded-[13%] bg-gradient-to-br from-white/22 via-transparent to-white/10"
    >
    </div>

    <div class="relative overflow-hidden rounded-[11%] bg-white">
      <Image
        src={image}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding="async"
        class="block h-auto w-full"
      />
    </div>
  </div>
</div>
