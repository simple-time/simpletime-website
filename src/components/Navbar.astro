---
import type { Lang } from '../i18n/ui';
import { useTranslations, APP_STORE_URL, langPrefix } from '../i18n/utils';
import LanguageMenu from './LanguageMenu.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const prefix = langPrefix(lang);
const home = `${prefix}/`;
const contactPath = `${prefix}/contact/`;

const links = [
  { href: `${home}#features`, label: t('nav.features') },
  { href: `${prefix}/pro/`, label: t('nav.pro') },
  { href: `${prefix}/faq/`, label: t('nav.faq') },
  { href: contactPath, label: t('nav.contact') },
];
---

<header class="site-header sticky top-0 z-50">
  <nav class="mx-auto flex h-[52px] max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href={home} class="flex shrink-0 items-center gap-2.5 font-semibold text-ink transition-opacity hover:opacity-70">
      <img src="/logo.png" alt="" width="28" height="28" class="h-7 w-7 rounded-[7px]" />
      <span class="text-[17px] tracking-[-0.02em]">SimpleTime</span>
    </a>

    <div class="hidden items-center gap-8 text-[13.5px] lg:flex">
      {
        links.map((l) => (
          <a href={l.href} class="text-ink/75 transition-colors hover:text-ink">
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-0.5 sm:gap-1.5">
      <button
        type="button"
        id="theme-toggle"
        class="grid h-9 w-9 place-items-center rounded-full text-ink/75 transition-colors hover:bg-surface-2 hover:text-ink"
        aria-label={t('nav.theme')}
      >
        <svg
          class="h-[17px] w-[17px] dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg
          class="hidden h-[17px] w-[17px] dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"
          ></path>
        </svg>
      </button>

      <LanguageMenu lang={lang} path={path} />

      <a
        href={APP_STORE_URL}
        target="_blank"
        rel="noopener"
        class="ms-1.5 hidden rounded-full bg-action px-3.5 py-[5px] text-[12.5px] font-medium text-on-action transition-colors hover:bg-action-hover sm:inline-flex"
      >
        {t('nav.appstore')}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="ms-0.5 grid h-9 w-9 place-items-center rounded-full text-ink/75 transition-colors hover:bg-surface-2 hover:text-ink lg:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path id="menu-icon-open" d="M4 8.5h16M4 15.5h16"></path>
          <path id="menu-icon-close" class="hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu hidden lg:hidden">
    <div class="mx-auto max-w-6xl px-6 pb-8 pt-3 sm:px-8">
      <ul class="flex flex-col">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="block py-2.5 text-[26px] font-semibold tracking-[-0.02em] text-ink/85 transition-colors hover:text-ink"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={APP_STORE_URL}
        target="_blank"
        rel="noopener"
        class="btn btn--primary mt-7 w-full"
      >
        {t('nav.appstore')}
      </a>
    </div>
  </div>
</header>

<style>
  /* Apple's translucent bar: the page shows through, blurred and a little
     more saturated, with a hairline that only appears once there is
     something underneath to separate from. */
  .site-header {
    background: var(--nav-bg);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow 0.3s ease;
  }

  .site-header[data-scrolled] {
    box-shadow: 0 1px 0 var(--line);
  }

  .mobile-menu {
    height: calc(100dvh - 52px);
    overflow-y: auto;
    background: var(--canvas);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mobile-menu:not(.hidden) li {
    animation: menu-in 0.45s var(--ease-out-soft) both;
  }

  .mobile-menu:not(.hidden) li:nth-child(2) {
    animation-delay: 0.04s;
  }

  .mobile-menu:not(.hidden) li:nth-child(3) {
    animation-delay: 0.08s;
  }

  .mobile-menu:not(.hidden) li:nth-child(4) {
    animation-delay: 0.12s;
  }
</style>

<script>
  const root = document.documentElement;

  // Theme toggle — persists the explicit choice, so it wins over the OS setting.
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      /* Private mode: the choice simply does not persist. */
    }
  });

  // The hairline under the bar, once the page has scrolled.
  const header = document.querySelector<HTMLElement>('.site-header');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    // The page behind a full-screen menu should not scroll.
    root.classList.toggle('overflow-hidden', open);
  };

  toggle?.addEventListener('click', () => {
    setMenu(menu?.classList.contains('hidden') ?? true);
  });

  // Close after following an in-page link, and on Escape.
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setMenu(false);
      toggle?.focus();
    }
  });
</script>
