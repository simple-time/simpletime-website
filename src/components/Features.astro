---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const features = [
  {
    key: 'instant',
    icon: `<path d="M13 2L4.5 13.2a.6.6 0 0 0 .5 1h5.2l-1.2 7.6a.6.6 0 0 0 1 .5L19.5 11a.6.6 0 0 0-.5-1h-5.2l1.2-7.6a.6.6 0 0 0-1-.4z"/>`,
  },
  {
    key: 'structured',
    icon: `<path d="M4 5h16"/><path d="M4 12h10"/><path d="M4 19h13"/><circle cx="19" cy="12" r="1.6"/>`,
  },
  {
    key: 'timeline',
    icon: `<circle cx="12" cy="12" r="9"/><path d="M12 7.2V12l3.2 2"/>`,
  },
  {
    key: 'stats',
    icon: `<path d="M3.5 3.5v17h17"/><rect x="7" y="12.5" width="3" height="5.5" rx="1"/><rect x="12" y="8.5" width="3" height="9.5" rx="1"/><rect x="17" y="5" width="3" height="13" rx="1"/>`,
  },
  {
    key: 'icloud',
    icon: `<path d="M7 18.5a4.5 4.5 0 0 1 .8-8.93A6.5 6.5 0 0 1 20.3 11.7 4.2 4.2 0 0 1 17 18.5z"/>`,
  },
  {
    key: 'export',
    icon: `<path d="M20.5 15v4.2a1.8 1.8 0 0 1-1.8 1.8H5.3a1.8 1.8 0 0 1-1.8-1.8V15"/><path d="M7.5 10L12 14.6 16.5 10"/><path d="M12 14.2V3.2"/>`,
  },
  {
    key: 'private',
    icon: `<path d="M12 3l7.5 3.5v5c0 4.6-3.2 7.8-7.5 9.2-4.3-1.4-7.5-4.6-7.5-9.2v-5L12 3z"/><path d="M9.3 12.2l1.9 1.9 3.6-3.7"/>`,
  },
] as const;
---

<section id="features" class="relative scroll-mt-20 bg-canvas-alt py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal mx-auto mb-14 max-w-2xl text-center sm:mb-18">
      <h2 class="text-display text-3xl font-bold sm:text-[2.75rem]">
        {t('features.title')}
      </h2>
      <p class="text-balance mt-5 text-[17px] leading-relaxed text-muted">
        {t('features.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f, i) => (
          <div
            class="reveal group rounded-3xl border border-line bg-surface p-7 transition-all duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-lift"
            data-reveal-delay={String((i % 3) * 70)}
          >
            <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-100 dark:bg-brand-700/25 dark:text-brand-200 dark:group-hover:bg-brand-700/40">
              <svg
                width="21"
                height="21"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={f.icon}
              />
            </div>
            <h3 class="text-[17px] font-semibold tracking-tight">
              {t(`features.${f.key}.title` as any)}
            </h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">
              {t(`features.${f.key}.body` as any)}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
