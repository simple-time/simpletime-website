---
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { home, store } = getContent(lang);

// One card per section of the App Store description, with its points word for
// word – this list and the App Store say exactly the same.
const icons: Record<string, string> = {
  tracking: `<circle cx="12" cy="12" r="9"/><path d="M10 8.6v6.8l5.4-3.4z"/>`,
  day: `<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17"/><path d="M8 3v4M16 3v4"/><path d="M7.5 13.5h4M7.5 16.5h7"/>`,
  insights: `<path d="M12 3.5a8.5 8.5 0 1 0 8.5 8.5H12z"/><path d="M15 3.8a8.5 8.5 0 0 1 5.2 5.2H15z"/>`,
  reports: `<path d="M14 3.5H7a1.8 1.8 0 0 0-1.8 1.8v13.4A1.8 1.8 0 0 0 7 20.5h10a1.8 1.8 0 0 0 1.8-1.8V8.3z"/><path d="M14 3.5v4.8h4.8"/><path d="M8.8 13h6.4M8.8 16.5h4.2"/>`,
  widgets: `<rect x="3.5" y="3.5" width="7.5" height="7.5" rx="2"/><rect x="13" y="3.5" width="7.5" height="7.5" rx="2"/><rect x="3.5" y="13" width="7.5" height="7.5" rx="2"/><rect x="13" y="13" width="7.5" height="7.5" rx="2"/>`,
  devices: `<rect x="2.5" y="5" width="13.5" height="10" rx="1.6"/><path d="M1.5 18.5h16"/><rect x="17.5" y="8" width="5" height="11" rx="1.3"/>`,
  data: `<path d="M12 3l7.5 3.5v5c0 4.6-3.2 7.8-7.5 9.2-4.3-1.4-7.5-4.6-7.5-9.2v-5L12 3z"/><path d="M9.3 12.2l1.9 1.9 3.6-3.7"/>`,
};
---

<section id="features" class="relative scroll-mt-20 bg-canvas-alt py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal mx-auto mb-14 max-w-2xl text-center sm:mb-18">
      <h2 class="text-display text-3xl font-bold sm:text-[2.75rem]">{home.features.title}</h2>
      <p class="text-balance mt-5 text-[17px] leading-relaxed text-muted">{home.features.subtitle}</p>
    </div>

    {/* Centred wrap rather than a grid: seven cards leave one over, and a lone
        card in the middle reads as intended where a gap on the right does not. */}
    <div class="flex flex-wrap justify-center gap-4">
      {
        store.sections.map((section, i) => (
          <div
            class="reveal group w-full rounded-3xl border border-line bg-surface p-7 transition-all duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-lift sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.667rem)]"
            data-reveal-delay={String((i % 3) * 70)}
          >
            <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-100 dark:bg-brand-700/25 dark:text-brand-200 dark:group-hover:bg-brand-700/40">
              <svg
                width="21"
                height="21"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[section.id]}
              />
            </div>
            <h3 class="text-[17px] font-semibold tracking-tight">{section.title}</h3>
            <ul class="mt-3 space-y-2">
              {section.points.map((point) => (
                <li class="flex gap-2.5 text-[15px] leading-relaxed text-muted">
                  <span aria-hidden="true" class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400 dark:bg-brand-300" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
