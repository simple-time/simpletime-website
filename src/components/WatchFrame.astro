---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  class?: string;
}

// An Apple Watch face around a 416 x 496 screenshot. Radii in cqw for the same
// reason as DeviceFrame: a percentage would turn the corners elliptical.
const { image, alt, class: className = '' } = Astro.props;
---

<div class={`@container relative ${className}`}>
  <div class="relative rounded-[24cqw] bg-[#0c0d10] p-[5cqw] shadow-device ring-1 ring-black/20 dark:ring-white/10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 rounded-[24cqw] bg-gradient-to-br from-white/25 via-white/5 to-white/15"
    >
    </div>
    <div class="relative overflow-hidden rounded-[19cqw] bg-black">
      <Image src={image} alt={alt} widths={[160, 240, 320]} sizes="160px" loading="lazy" decoding="async" class="block h-auto w-full" />
    </div>
  </div>
</div>
