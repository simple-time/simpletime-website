---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Aluminium case: dark (default) or silver. */
  finish?: 'dark' | 'silver';
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

// An Apple Watch around a 416 x 496 screenshot. The drawing lives in
// src/styles/devices.css, in cqw for the same reason as the iPhone's.
const { image, alt, finish = 'dark', sizes = '200px', loading = 'lazy', class: className = '' } = Astro.props;
---

<div class:list={['watch', finish === 'silver' && 'watch--silver', className]}>
  <span class="watch__strap watch__strap--top" aria-hidden="true"></span>
  <span class="watch__strap watch__strap--bottom" aria-hidden="true"></span>
  <span class="watch__crown" aria-hidden="true"></span>
  <span class="watch__button" aria-hidden="true"></span>
  <div class="watch__case">
    <div class="watch__glass">
      <div class="watch__screen">
        <Image src={image} alt={alt} widths={[160, 240, 320, 416]} sizes={sizes} loading={loading} decoding="async" />
      </div>
    </div>
  </div>
</div>
