---
import type { Lang } from '../i18n/ui';
import type { FaqItem } from '../i18n/content';
import RichText from './RichText.astro';

interface Props {
  lang: Lang;
  item: FaqItem;
  /** Give the entry its id as an anchor – only once per page, on /faq/. */
  anchor?: boolean;
}

const { lang, item, anchor = false } = Astro.props;
---

<details
  class="faq-entry group scroll-mt-24"
  id={anchor ? item.id : undefined}
  data-faq-item={anchor ? '' : undefined}
>
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[17px] font-semibold tracking-[-0.012em] text-ink sm:py-6 sm:text-[19px]"
  >
    <span>{item.q}</span>
    <span
      class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-surface-2 text-ink transition-[transform,background-color] duration-300 group-open:rotate-45 group-hover:bg-line"
      aria-hidden="true"
    >
      <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M6 1.5v9M1.5 6h9"></path>
      </svg>
    </span>
  </summary>
  <div class="space-y-3 pb-6 pe-12 text-[16px] leading-relaxed text-muted">
    {
      item.a.map((paragraph) => (
        <p>
          <RichText text={paragraph} lang={lang} />
        </p>
      ))
    }
  </div>
</details>

<style>
  /* Safari still renders the default disclosure triangle without this. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
