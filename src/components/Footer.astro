---
import type { Lang } from '../i18n/ui';
import { useTranslations, APP_STORE_URL, CONTACT_EMAIL, langPrefix } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const prefix = langPrefix(lang);
const links = {
  home: `${prefix}/`,
  pro: `${prefix}/pro/`,
  faq: `${prefix}/faq/`,
  contact: `${prefix}/contact/`,
  imprint: `${prefix}/imprint/`,
  privacy: `${prefix}/privacy/`,
};

const linkClass = 'inline-block py-1 text-muted transition-colors hover:text-ink';
---

<footer class="bg-canvas-alt text-[13px]">
  <div class="mx-auto max-w-6xl px-5 pb-10 pt-14 sm:px-8 sm:pt-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href={links.home} class="inline-flex items-center gap-2.5">
          <img src="/logo.png" alt="" width="32" height="32" class="h-8 w-8 rounded-[8px]" />
          <span class="text-[17px] font-semibold tracking-[-0.02em] text-ink">SimpleTime</span>
        </a>
        <p class="mt-4 max-w-xs text-[14px] leading-relaxed text-muted">{t('footer.tagline')}</p>
      </div>

      <div>
        <h2 class="text-[13px] font-semibold text-ink">{t('footer.product')}</h2>
        <ul class="mt-3 space-y-1">
          <li>
            <a href={APP_STORE_URL} target="_blank" rel="noopener" class={linkClass}>{t('footer.appstore')}</a>
          </li>
          <li><a href={links.pro} class={linkClass}>{t('footer.pro')}</a></li>
          <li><a href={links.faq} class={linkClass}>{t('nav.faq')}</a></li>
          <li><a href={links.contact} class={linkClass}>{t('footer.contact')}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[13px] font-semibold text-ink">{t('footer.legal')}</h2>
        <ul class="mt-3 space-y-1">
          <li><a href={links.imprint} class={linkClass}>{t('footer.imprint')}</a></li>
          <li><a href={links.privacy} class={linkClass}>{t('footer.privacy')}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-line-strong pt-6 text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>{t('footer.copyright', { year })}</p>
      <a href={`mailto:${CONTACT_EMAIL}`} class="transition-colors hover:text-ink">
        {CONTACT_EMAIL}
      </a>
    </div>
  </div>
</footer>
