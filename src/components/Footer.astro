---
import type { Lang } from '../i18n/ui';
import { useTranslations, APP_STORE_URL, CONTACT_EMAIL, langPrefix } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const prefix = langPrefix(lang);
const links = {
  home: `${prefix}/`,
  contact: `${prefix}/contact/`,
  imprint: `${prefix}/imprint/`,
  privacy: `${prefix}/privacy/`,
};
---

<footer class="border-t border-line bg-canvas-alt">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href={links.home} class="inline-flex items-center gap-2.5">
          <img src="/logo.png" alt="" width="36" height="36" class="rounded-[10px]" />
          <span class="text-lg font-semibold tracking-tight text-ink">SimpleTime</span>
        </a>
        <p class="mt-4 max-w-xs text-[15px] leading-relaxed text-muted">{t('footer.tagline')}</p>
      </div>

      <div>
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.1em] text-subtle">
          {t('footer.product')}
        </h2>
        <ul class="mt-4 space-y-1.5 text-[15px]">
          <li>
            <a
              href={APP_STORE_URL}
              target="_blank"
              rel="noopener"
              class="inline-block py-1 text-muted transition-colors hover:text-ink">{t('footer.appstore')}</a
            >
          </li>
          <li>
            <a href={`${links.home}#faq`} class="inline-block py-1 text-muted transition-colors hover:text-ink"
              >{t('nav.faq')}</a
            >
          </li>
          <li>
            <a href={links.contact} class="inline-block py-1 text-muted transition-colors hover:text-ink"
              >{t('footer.contact')}</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.1em] text-subtle">
          {t('footer.legal')}
        </h2>
        <ul class="mt-4 space-y-1.5 text-[15px]">
          <li>
            <a href={links.imprint} class="inline-block py-1 text-muted transition-colors hover:text-ink"
              >{t('footer.imprint')}</a
            >
          </li>
          <li>
            <a href={links.privacy} class="inline-block py-1 text-muted transition-colors hover:text-ink"
              >{t('footer.privacy')}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line pt-8 text-[13px] text-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <p>{t('footer.copyright', { year })}</p>
      <a href={`mailto:${CONTACT_EMAIL}`} class="transition-colors hover:text-ink">
        {CONTACT_EMAIL}
      </a>
    </div>
  </div>
</footer>
