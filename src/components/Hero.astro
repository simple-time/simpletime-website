---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getContent } from '../i18n/content';
import { phoneScreen, watchScreen } from '../i18n/screens';
import AppStoreButton from './AppStoreButton.astro';
import DeviceFrame from './DeviceFrame.astro';
import WatchFrame from './WatchFrame.astro';
import LiveActivity from './LiveActivity.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { home, store, shots } = getContent(lang);
const hero = home.hero;

// Price, account, privacy – the three things people check before downloading.
const proofIcons = [
  '<path d="M12 3v18"/><path d="M16.5 7.5C15.7 6.4 14 6 12 6c-2.5 0-4 1.1-4 2.9 0 4.2 8.4 2 8.4 6.2 0 1.9-1.7 3-4.4 3-2.2 0-3.9-.5-4.7-1.7"/>',
  '<circle cx="12" cy="8" r="3.4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>',
  '<path d="M12 3l7.5 3.5v5c0 4.6-3.2 7.8-7.5 9.2-4.3-1.4-7.5-4.6-7.5-9.2v-5L12 3z"/><path d="M9.3 12.2l1.9 1.9 3.6-3.7"/>',
];
const proof = hero.proof.map((label, i) => ({ label, icon: proofIcons[i] }));

// Chinese and Japanese run sentences together; everywhere else they are spaced.
const sentenceGap = lang === 'ja' || lang === 'zh' ? '' : ' ';
---

<section class="hero relative overflow-hidden">
  <div class="mx-auto max-w-5xl px-5 pt-10 text-center sm:px-8 sm:pt-14 lg:pt-16">
    <img
      src="/logo.png"
      alt=""
      width="96"
      height="96"
      class="hero-in hero-icon mx-auto h-[72px] w-[72px] rounded-[22.5%] sm:h-[84px] sm:w-[84px]"
    />

    <h1 class="hero-in hero-in--1 t-hero mt-6 sm:mt-7">
      <span class="block">{hero.titleLead}</span>
      <span class="block text-accent">{hero.titleAccent}</span>
    </h1>

    {/* The first two paragraphs of the App Store description, word for word. */}
    <p class="hero-in hero-in--2 t-intro mx-auto mt-5 max-w-[46rem] text-muted">
      {`${store.lead}${sentenceGap}${store.promise}`}
    </p>

    <div class="hero-in hero-in--3 mt-8 flex flex-col items-center justify-center gap-x-7 gap-y-5 sm:flex-row">
      <AppStoreButton label={t('appstore.download')} size="lg" />
      <a href="#features" class="link-more text-[17px]">
        {hero.cta}
        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 2.5L8 6l-3.5 3.5"></path>
        </svg>
      </a>
    </div>

    <ul class="hero-in hero-in--4 mt-7 flex flex-wrap justify-center gap-x-6 gap-y-2.5 text-[14px] text-muted">
      {
        proof.map((p) => (
          <li class="inline-flex items-center gap-2">
            <svg
              class="h-4 w-4 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={p.icon}
            />
            {p.label}
          </li>
        ))
      }
    </ul>
  </div>

  {/* The stage: three iPhones, the Live Activity and the watch. Only the
      middle screen is described – the others repeat what the gallery shows. */}
  <div class="hero-stage" dir="ltr">
    <div class="hero-stage__glow" aria-hidden="true"></div>
    <div class="hero-stage__floor">
      <DeviceFrame
        image={phoneScreen(lang, 'timeline')}
        alt=""
        class="hero-phone hero-phone--left"
        sizes="(min-width: 1280px) 290px, 24vw"
        widths={[240, 290, 480, 580]}
      />
      <DeviceFrame
        image={phoneScreen(lang, 'chart')}
        alt=""
        class="hero-phone hero-phone--right"
        sizes="(min-width: 1280px) 290px, 24vw"
        widths={[240, 290, 480, 580]}
      />
      <DeviceFrame
        image={phoneScreen(lang, 'tracking')}
        alt={shots[0].alt}
        loading="eager"
        finish="blue"
        class="hero-phone hero-phone--center"
        sizes="(min-width: 1280px) 340px, (min-width: 640px) 28vw, 64vw"
        widths={[260, 340, 520, 680, 720]}
      />
      <div class="hero-live" dir={lang === 'ar' || lang === 'he' ? 'rtl' : 'ltr'}>
        <LiveActivity lang={lang} />
      </div>
      <WatchFrame image={watchScreen(lang, 'running')} alt="" class="hero-watch" sizes="180px" />
    </div>
  </div>
</section>

<style>
  .hero-icon {
    box-shadow:
      0 1px 2px rgb(10 22 60 / 0.12),
      0 12px 30px -10px rgb(10 22 60 / 0.45);
  }

  /* ------------------------------------------------------------ stage --- */

  /* The phones and the watch are child components, so their classes are
     reached through :global() under the stage, which is this file's own. */
  .hero-stage {
    --pw: min(64vw, 270px);
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    /* The phones run off the bottom and fade into the page. */
    height: calc(var(--pw) * 2.105 * 0.82);
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 76%, transparent 100%);
  }

  @media (min-width: 640px) {
    .hero-stage {
      --pw: 27vw;
    }
  }

  @media (min-width: 1280px) {
    .hero-stage {
      --pw: 340px;
    }
  }

  .hero-stage__glow {
    position: absolute;
    left: 50%;
    top: 8%;
    width: min(1100px, 160vw);
    height: 80%;
    translate: -50% 0;
    background: radial-gradient(50% 50% at 50% 50%, var(--glow) 0%, transparent 70%);
  }

  .hero-stage__floor {
    position: relative;
    height: 100%;
  }

  .hero-stage :global(.hero-phone) {
    position: absolute;
    top: 0;
  }

  .hero-stage :global(.hero-phone--center) {
    z-index: 3;
    width: var(--pw);
    left: calc(50% - var(--pw) / 2);
  }

  .hero-stage :global(.hero-phone--left),
  .hero-stage :global(.hero-phone--right) {
    z-index: 2;
    width: calc(var(--pw) * 0.84);
    top: calc(var(--pw) * 0.26);
    display: none;
  }

  .hero-stage :global(.hero-phone--left) {
    left: calc(50% - var(--pw) * 0.5 - var(--pw) * 0.84 * 0.82);
  }

  .hero-stage :global(.hero-phone--right) {
    left: calc(50% + var(--pw) * 0.5 - var(--pw) * 0.84 * 0.18);
  }

  .hero-live {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: calc(var(--pw) * 0.94);
    translate: -50% 0;
    /* The card is drawn in em: this keeps it in proportion to the phones. */
    font-size: clamp(11px, calc(var(--pw) * 0.047), 16px);
  }

  .hero-stage :global(.hero-watch) {
    position: absolute;
    z-index: 4;
    display: none;
    width: calc(var(--pw) * 0.5);
    left: calc(50% + var(--pw) * 0.66);
    top: calc(var(--pw) * 0.98);
  }

  @media (min-width: 640px) {
    .hero-stage :global(.hero-phone--left),
    .hero-stage :global(.hero-phone--right) {
      display: block;
    }

    .hero-live {
      left: calc(50% - var(--pw) * 1.5);
      top: calc(var(--pw) * 1.04);
      translate: none;
    }
  }

  @media (min-width: 1024px) {
    .hero-stage :global(.hero-watch) {
      display: block;
    }
  }

  /* ------------------------------------------------------------ motion --- */

  /* On load: the copy rises line by line, the phones fan out from behind
     the middle one, then the Live Activity and the watch arrive. */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }

  @keyframes hero-center {
    from {
      opacity: 0;
      transform: translateY(90px) scale(0.96);
    }
  }

  @keyframes hero-fan-left {
    from {
      opacity: 0;
      transform: translateX(42%) scale(0.92);
    }
  }

  @keyframes hero-fan-right {
    from {
      opacity: 0;
      transform: translateX(-42%) scale(0.92);
    }
  }

  @keyframes hero-pop {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.94);
    }
  }

  /* Depth while scrolling: the side phones lag behind, the watch comes forward. */
  @keyframes hero-sink {
    to {
      translate: 0 70px;
    }
  }

  @keyframes hero-lift {
    to {
      translate: 0 -60px;
    }
  }

  :global(.js) .hero-in {
    animation: hero-rise 1s var(--ease-out-soft) both;
  }

  :global(.js) .hero-in--1 {
    animation-delay: 0.08s;
  }

  :global(.js) .hero-in--2 {
    animation-delay: 0.16s;
  }

  :global(.js) .hero-in--3 {
    animation-delay: 0.24s;
  }

  :global(.js) .hero-in--4 {
    animation-delay: 0.32s;
  }

  :global(.js) .hero-stage :global(.hero-phone--center) {
    animation: hero-center 1.4s var(--ease-out-soft) 0.2s both;
  }

  :global(.js) .hero-stage :global(.hero-phone--left) {
    animation: hero-fan-left 1.5s var(--ease-out-soft) 0.55s both;
  }

  :global(.js) .hero-stage :global(.hero-phone--right) {
    animation: hero-fan-right 1.5s var(--ease-out-soft) 0.55s both;
  }

  :global(.js) .hero-live > :global(*) {
    animation: hero-pop 1.1s var(--ease-out-soft) 1.05s both;
  }

  :global(.js) .hero-stage :global(.hero-watch) {
    animation: hero-pop 1.1s var(--ease-out-soft) 1.2s both;
  }

  /* Where the browser can tie motion to scrolling, the entrance and the
     depth run side by side: one moves `transform`, the other `translate`. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.js) .hero-stage :global(.hero-phone--left) {
        animation:
          hero-fan-left 1.5s var(--ease-out-soft) 0.55s both,
          hero-sink linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 800px;
      }

      :global(.js) .hero-stage :global(.hero-phone--right) {
        animation:
          hero-fan-right 1.5s var(--ease-out-soft) 0.55s both,
          hero-sink linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 800px;
      }

      :global(.js) .hero-stage :global(.hero-watch) {
        animation:
          hero-pop 1.1s var(--ease-out-soft) 1.2s both,
          hero-lift linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 800px;
      }
    }
  }
</style>
