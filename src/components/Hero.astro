---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import AppStoreButton from './AppStoreButton.astro';
import DeviceFrame from './DeviceFrame.astro';
import trackScreen from '../assets/screens/track.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const proof = [
  {
    label: t('hero.proof.price'),
    icon: '<path d="M12 3v18"/><path d="M16.5 7.5C15.7 6.4 14 6 12 6c-2.5 0-4 1.1-4 2.9 0 4.2 8.4 2 8.4 6.2 0 1.9-1.7 3-4.4 3-2.2 0-3.9-.5-4.7-1.7"/>',
  },
  {
    label: t('hero.proof.account'),
    icon: '<circle cx="12" cy="8" r="3.4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>',
  },
  {
    label: t('hero.proof.private'),
    icon: '<path d="M12 3l7.5 3.5v5c0 4.6-3.2 7.8-7.5 9.2-4.3-1.4-7.5-4.6-7.5-9.2v-5L12 3z"/><path d="M9.3 12.2l1.9 1.9 3.6-3.7"/>',
  },
];
---

<section class="relative overflow-hidden">
  <!-- Ambient backdrop: a soft brand wash instead of a hard colour block. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute inset-x-0 top-0 h-[620px] bg-gradient-to-b from-brand-50 via-canvas to-canvas dark:from-brand-950/60 dark:via-canvas dark:to-canvas"
    >
    </div>
    <div
      class="absolute -top-32 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-brand-200/30 blur-[130px] dark:bg-brand-700/20"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 pb-16 pt-14 sm:px-8 sm:pb-24 sm:pt-20 lg:pb-28 lg:pt-24">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8">
      <div class="reveal text-center lg:text-start">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3.5 py-1.5 text-[13px] font-medium text-muted backdrop-blur"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
          {t('hero.eyebrow')}
        </p>

        <h1 class="text-display mt-6 text-[2.75rem] font-bold sm:text-6xl lg:text-[4.25rem]">
          {t('hero.title.part1')}<br />
          <span
            class="bg-gradient-to-br from-brand-700 via-brand-500 to-brand-400 bg-clip-text text-transparent dark:from-brand-200 dark:via-brand-300 dark:to-brand-400"
          >
            {t('hero.title.part2')}
          </span>
        </h1>

        <p
          class="text-balance mx-auto mt-6 max-w-xl text-[17px] leading-relaxed text-muted sm:text-lg lg:mx-0"
        >
          {t('hero.subtitle')}
        </p>

        <div
          class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start"
        >
          <AppStoreButton label={t('hero.cta.appstore')} size="lg" />
          <a
            href="#features"
            class="group inline-flex items-center gap-1.5 rounded-2xl px-5 py-3.5 font-medium text-ink transition-colors hover:bg-surface-2"
          >
            {t('hero.cta.features')}
            <svg
              class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100"
              viewBox="0 0 14 14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 7h8"></path>
              <path d="M7 3l4 4-4 4"></path>
            </svg>
          </a>
        </div>

        <ul
          class="mt-9 flex flex-wrap justify-center gap-x-6 gap-y-3 text-[14px] text-subtle lg:justify-start"
        >
          {
            proof.map((p) => (
              <li class="inline-flex items-center gap-2">
                <svg
                  class="h-4 w-4 text-brand-500 dark:text-brand-300"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={p.icon}
                />
                {p.label}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal relative mx-auto w-full max-w-[280px] sm:max-w-[320px]" data-reveal-delay="120">
        <!-- Glow behind the device so it lifts off the page. -->
        <div
          aria-hidden="true"
          class="absolute inset-x-4 top-10 -z-10 h-3/4 rounded-full bg-brand-400/25 blur-[70px] dark:bg-brand-500/25"
        >
        </div>
        <DeviceFrame
          image={trackScreen}
          alt="SimpleTime tracking screen with favorites and activities"
          loading="eager"
          sizes="(min-width: 640px) 320px, 280px"
          widths={[280, 320, 560, 640]}
        />
      </div>
    </div>
  </div>
</section>
