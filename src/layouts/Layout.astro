---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { languages, type Lang } from '../i18n/ui';
import { useTranslations, getAllLangPaths } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  path: string;
  /** Extra schema.org objects to embed, e.g. the FAQ on the home page. */
  jsonLd?: Record<string, unknown>[];
  /** The 404 has no real URL: skip canonical, hreflang and indexing. */
  noIndex?: boolean;
}

const { lang, title, description, path, jsonLd = [], noIndex = false } = Astro.props;
const t = useTranslations(lang);

const metaTitle = title ?? t('meta.title');
const metaDescription = description ?? t('meta.description');
const site = Astro.site ?? 'https://simple-time.app';
const canonical = new URL(path, site).toString();
const langPaths = getAllLangPaths(path);

const OG_LOCALE: Record<string, string> = {
  en: 'en_US',
  de: 'de_DE',
  fr: 'fr_FR',
  es: 'es_ES',
  it: 'it_IT',
  ru: 'ru_RU',
  hy: 'hy_AM',
  pt: 'pt_PT',
  tr: 'tr_TR',
  ar: 'ar_AR',
  ja: 'ja_JP',
  zh: 'zh_CN',
  hi: 'hi_IN',
  nl: 'nl_NL',
  sv: 'sv_SE',
  uk: 'uk_UA',
  el: 'el_GR',
  he: 'he_IL',
};
const ogImage = new URL(lang === 'en' ? '/og.png' : `/og-${lang}.png`, site).toString();

// Arabic and Hebrew are right-to-left; everything else reads left-to-right.
const RTL_LOCALES = new Set<Lang>(['ar', 'he']);
const dir = RTL_LOCALES.has(lang) ? 'rtl' : 'ltr';

// No font preloads: Apple devices set the page in their own system face and
// never fetch Inter or Noto, and a preload would make them download it anyway.
// Everyone else gets the faces from fonts.css, swapped in as they arrive.

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SimpleTime',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'iOS, iPadOS, macOS, watchOS',
  url: site.toString(),
  description: metaDescription,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
  author: {
    '@type': 'Person',
    name: 'Luca Efinger',
  },
};

const schemas = [appSchema, ...jsonLd];

// JSON.stringify does not escape "<", so a "</script>" inside any value
// would close the tag early. No current string contains one, but escaping
// removes the class of bug rather than relying on that staying true.
const jsonLdPayload = JSON.stringify(schemas).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {/* Safari on iPhone and iPad shows its own "Get" / "Open" banner for the app. */}
    <meta name="apple-itunes-app" content="app-id=6755532037" />
    {noIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {/* Round in the browser tab; the Apple touch icon stays square because
        iOS applies its own mask and renders transparency as black. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />

    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SimpleTime" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.title')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    {
      !noIndex && (
        <>
          {(Object.keys(languages) as (keyof typeof languages)[]).map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(langPaths[l], site).toString()} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(langPaths.en, site).toString()} />
        </>
      )
    }

    <script is:inline set:html={jsonLdPayload} type="application/ld+json" />

    {/* Runs before first paint so the correct theme is applied without a flash. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          /* Storage blocked: no saved choice, so the OS setting decides. */
        }
        const dark =
          saved === 'dark' ||
          (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.classList.toggle('dark', dark);
      })();
    </script>

    {/* Visitor statistics with Atriya, our own analytics server: cookieless,
        nothing read from or stored in the browser, no session recordings.
        Off with Do Not Track or Global Privacy Control. See the privacy page. */}
    <script
      is:inline
      defer
      src="https://intern.atriya.io/t.js"
      data-key="atr_pk_uw7Nhe9xKAljv5TFADToyd2s"
      data-cookieless="true"
      data-auto-replay="false"
    ></script>
  </head>
  <body class="bg-canvas text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:rounded-xl focus:bg-action focus:px-4 focus:py-2.5 focus:text-sm focus:font-medium focus:text-on-action"
    >
      {t('skip.content')}
    </a>

    {/* The 404 has no localised twin, so its language switch targets the home page. */}
    <Navbar lang={lang} path={noIndex ? '/' : path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Reveal sections as they scroll into view. The `.js` class on <html>
      // means no-JS visitors never see the hidden starting state. Delays come
      // from the `delay-*` classes in global.css – the CSP allows no inline styles.
      const items = document.querySelectorAll<HTMLElement>('.reveal, .reveal-media');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
