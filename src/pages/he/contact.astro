---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { useTranslations, CONTACT_EMAIL } from '../../i18n/utils';

const lang = 'he';
const t = useTranslations(lang);
---

<Layout lang={lang} path="/he/contact/" title={`${t('contact.title')} · SimpleTime`} description={t('meta.contact.description')}>
  <PageHeader title={t('contact.title')} subtitle={t('contact.subtitle')} />

  <section class="mx-auto max-w-2xl px-5 sm:px-8 py-20">
    <div class="rounded-3xl border border-line bg-surface p-8 sm:p-10">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-accent">{t('contact.email.label')}</h2>
      <p class="mt-3 text-muted leading-relaxed">{t('contact.email.body')}</p>

      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="mt-6 inline-flex items-center gap-2 text-xl sm:text-2xl font-semibold text-accent hover:text-accent-hover transition-colors break-all"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <polyline points="3 7 12 13 21 7" />
        </svg>
        {CONTACT_EMAIL}
      </a>

      <p class="mt-8 text-sm text-subtle leading-relaxed">{t('contact.response')}</p>
    </div>
  </section>
</Layout>
