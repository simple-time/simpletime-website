---
import Layout from '../layouts/Layout.astro';

// The 404 is served for every unmatched path in every locale, so it ships
// English and swaps to the visitor's language at runtime. Showing one
// language at a time keeps it readable and avoids mixed-language markup.
const COPY = {
  de: {
    title: 'Seite nicht gefunden',
    body: 'Die Seite, die du suchst, existiert nicht oder wurde verschoben.',
    home: 'Zurück zur Startseite',
  },
  fr: {
    title: 'Page introuvable',
    body: 'La page que vous cherchez n’existe pas ou a été déplacée.',
    home: 'Retour à l’accueil',
  },
  es: {
    title: 'Página no encontrada',
    body: 'La página que buscas no existe o se ha movido.',
    home: 'Volver al inicio',
  },
};
---

<Layout lang="en" path="/404/" title="404 · Page not found · SimpleTime" noIndex>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="absolute inset-0 bg-gradient-to-b from-brand-50 to-canvas dark:from-brand-950/60 dark:to-canvas"
      >
      </div>
      <div
        class="absolute -top-40 left-1/2 h-[420px] w-[760px] -translate-x-1/2 rounded-full bg-brand-200/40 blur-[120px] dark:bg-brand-700/20"
      >
      </div>
    </div>

    <div class="mx-auto max-w-3xl px-5 py-28 text-center sm:px-8 sm:py-36">
      <p
        class="text-display bg-gradient-to-br from-brand-700 via-brand-500 to-brand-400 bg-clip-text text-[110px] font-bold text-transparent sm:text-[150px] dark:from-brand-200 dark:via-brand-300 dark:to-brand-400"
      >
        404
      </p>

      <h1 id="nf-title" class="text-display mt-4 text-3xl font-bold sm:text-4xl">Page not found</h1>

      <p id="nf-body" class="mx-auto mt-6 max-w-md leading-relaxed text-muted">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <div class="mt-10 flex justify-center">
        <a
          id="home-link"
          href="/"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-medium text-on-accent transition-opacity hover:opacity-90"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5"></path>
            <path d="m12 19-7-7 7-7"></path>
          </svg>
          <span id="home-link-label">Back to home</span>
        </a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ COPY }}>
    (function () {
      var match = window.location.pathname.match(/^\/(de|fr|es)(?=\/|$)/);
      if (!match) return;
      var copy = COPY[match[1]];
      if (!copy) return;

      document.documentElement.lang = match[1];
      document.getElementById('nf-title').textContent = copy.title;
      document.getElementById('nf-body').textContent = copy.body;
      document.getElementById('home-link').setAttribute('href', '/' + match[1] + '/');
      document.getElementById('home-link-label').textContent = copy.home;
    })();
  </script>
</Layout>
